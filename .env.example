# ── Application (Vite) — copier ce fichier en .env et renseigner les valeurs ──────────────────
# Projet Firebase visé : crm-pose-dev (développement) ou crm-label-pose (production).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Mode d'écriture des écrans d'administration :
#   direct    (défaut) : depuis le navigateur, protégé par les règles Firestore
#   functions          : via les fonctions Firebase (secours, quand elles sont déployées)
VITE_ADMIN_WRITE_MODE=direct

# ── Réception des leads (fonction Netlify) — à définir dans Netlify, PAS dans ce fichier ───────
# CL_INGEST_SECRET=                      secret partagé avec la source de leads
# FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=  clé du compte de service du projet Firebase visé
